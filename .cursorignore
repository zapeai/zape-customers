# Cursor AI Ignore File
# Prevents Cursor from indexing these files/folders for better performance

# Dependencies (too large for AI context)
node_modules/
.pnp/
.pnp.js

# Build outputs
.next/
out/
build/
dist/

# Cache directories
.cache/
.turbo/
.vercel/

# Test coverage
coverage/
.nyc_output/

# Environment files (sensitive)
.env
.env.local
.env*.local

# Lock files (not useful for AI context)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.sublime-workspace

# TypeScript build info
*.tsbuildinfo

# Large media files (if any)
*.mp4
*.mov
*.avi
*.webm

# Documentation that's too large
node_modules/
.next/

